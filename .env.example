# ============================================================
#  PAANY — configuração. Copie para ".env" e preencha.
#  NUNCA publique o arquivo .env nem mande ele no Discord.
# ============================================================

# --- Discord (Developer Portal → sua aplicação) ---
# Quem está em ADMIN_IDS também é quem entra no painel web.
DISCORD_TOKEN=cole_o_token_do_bot_aqui
DISCORD_CLIENT_ID=id_da_aplicacao
DISCORD_GUILD_ID=id_do_servidor_da_cutify

# IDs de quem pode usar o painel administrativo (separe por vírgula)
ADMIN_IDS=123456789012345678
# Cargo da equipe de suporte (vê e responde tickets)
STAFF_ROLE_ID=

# --- Loja ---
STORE_NAME=Cutify
BOT_NAME=Paany
# Minutos para pagar o Pix antes do pedido expirar
ORDER_EXPIRES_MINUTES=30
MAX_PENDING_ORDERS=3
# Dias de antecedência do aviso de VIP vencendo
VIP_WARN_DAYS=3
# Gera transcrição ao fechar ticket (exige "Message Content Intent" ligado)
ENABLE_TRANSCRIPTS=true

# --- Mercado Pago: Pix automático ---
# Painel do desenvolvedor → Suas integrações → Credenciais de produção → Access Token
# (Para testar, use o Access Token de TESTE, que começa com TEST-)
MP_ACCESS_TOKEN=
# E-mail usado como pagador na cobrança Pix (pode ser um e-mail da loja)
MP_PAYER_EMAIL=
# A cada quantos segundos o bot confere os Pix pendentes (funciona sem webhook)
MP_POLL_SECONDS=20

# --- Endereço público (hospedagem paga) ---
# Liga o painel web e o webhook do Mercado Pago. Deixe vazio na hospedagem grátis.
#
# Painel na Vercel + bot na Discloud (recomendado):
#   PUBLIC_URL = endereço do painel na VERCEL (ex.: https://painel-cutify.vercel.app)
#   PORT=8080 e HOST=0.0.0.0 (exigência da Discloud para sites)
#   BRIDGE_SECRET = senha longa e aleatória; coloque a MESMA na Vercel
#
# Tudo na Square Cloud: PUBLIC_URL=https://SEU-SUBDOMINIO.squareweb.app e PORT=80
PUBLIC_URL=
PORT=8080
HOST=0.0.0.0
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_SECRET=

# Webhook do Mercado Pago (confirmação instantânea do Pix):
# painel do Mercado Pago → Webhooks → URL: PUBLIC_URL/webhook/mercadopago, evento "Pagamentos"
MP_WEBHOOK_SECRET=

# --- Painel web ---
# Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
# Senha interna das sessões: 32+ caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor desconecta todo mundo do painel.
PANEL_SECRET=

# --- Pix manual (conferido pela equipe) ---
# Sua chave Pix: e-mail, CPF/CNPJ só números, telefone +5511999999999 ou chave aleatória
PIX_KEY=
# Nome e cidade do titular da conta (como aparece no banco)
PIX_NAME=
PIX_CITY=

# --- Vídeos e músicas livres (opcional, chaves gratuitas) ---
# /video usa o Pexels (preferido) ou o Pixabay; basta uma das duas chaves.
#   Pexels:  https://www.pexels.com/api/  (crie a conta e copie a API Key)
#   Pixabay: https://pixabay.com/api/docs/  (a chave aparece logada na página)
PEXELS_API_KEY=
PIXABAY_API_KEY=
# /musica usa o Jamendo (músicas Creative Commons):
#   https://devportal.jamendo.com  → crie um app e copie o Client ID
JAMENDO_CLIENT_ID=

# --- Banco de dados ---
DB_PATH=data/paany.db
BACKUP_KEEP=7
